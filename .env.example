# Rally Gateway configuration.
# Copy to `.env`, fill in real values, and keep `.env` out of git (it is ignored).
# Mirrors the rally-order `.env` pattern: JWT_SECRET must match every service
# (the Auth Service signs with it; gateway + all services validate with it).

JWT_SECRET=*****

GATEWAY_PORT=8080

# Rate limiter backend (Redis). Defaults to localhost:6379 if unset.
REDIS_HOST=localhost
REDIS_PORT=6379

# Service URIs — ports must match each service's own server.port config:
# catalog=8083 (per PROJECT-REFERENCE.md), order=8010, payment=8082,
# auth=8084, deal=8085, participation=8086, inventory=8087, notification=8088.
AUTH_SERVICE_URI=http://localhost:8084
CATALOG_SERVICE_URI=http://localhost:8083
DEAL_SERVICE_URI=http://localhost:8085
PARTICIPATION_SERVICE_URI=http://localhost:8086
INVENTORY_SERVICE_URI=http://localhost:8087
ORDER_SERVICE_URI=http://localhost:8010
PAYMENT_SERVICE_URI=http://localhost:8082
NOTIFICATION_SERVICE_URI=http://localhost:8088

CORS_ORIGIN_DEV=http://localhost:5173
CORS_ORIGIN_PROD=http://localhost:4200
